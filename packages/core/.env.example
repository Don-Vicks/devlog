# Copy this to .env and fill in your own keys. Never commit .env.

# --- AI generation (free-tier friendly) ---
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GROQ_API_KEY=               # https://console.groq.com/keys (fallback model)
OLLAMA_HOST=http://localhost:11434   # for local/private-repo generation

# --- X (Twitter) API v2 ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_PORT=4321

# --- LinkedIn (added later, needs partner approval for posting scope) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Meta / Facebook / Instagram ---
META_APP_ID=
META_APP_SECRET=

# --- Optional review queue via Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
